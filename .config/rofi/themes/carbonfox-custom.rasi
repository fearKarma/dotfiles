//@theme "carbon-fox-custom"

* {
    background-color:   #0a0a0a;
    border-color:       #0a0a0a;
    border-radius:      4px;
    border-width:       1px;
    padding:            6px;
    font:               "Iosevka Nerd Font 12";
    /* Optional global fallback text color (can be overridden) */
    text-color:         #ffffff;
}

window {
    background-color:   #0a0a0a;
    border-color:       #0a0a0a;
}

inputbar {
    background-color:   #0a0a0a;
    border-color:       #222222;
}

entry {
    background-color:   #0a0a0a;
    text-color:         #ffffff;      /* typed text / prompt text */
    padding:            4px 8px;
}

listview {
    lines:              10;
    fixed-height:       0;
}

element-text {
    background-color:   inherit;
    text-color:         inherit;      /* ← crucial: inherit from element's text-color */
    padding:            4px 8px;
}

element {
    text-color:         #ffffff;      /* base for all non-selected states */
}

element normal {
    background-color:   #111111;
    text-color:         #ffffff;
}

element normal alternate {
    background-color:   #121212;
    text-color:         #ffffff;
}

element selected {
    background-color:   #ff79c6;      /* pink bg for selected */
    text-color:         #0a0a0a;      /* black text on pink */
}

element active {
    background-color:   #1c1c1c;
    /* text-color stays inherited → white */
}

element urgent {
    background-color:   #0a0a0a;
    text-color:         #ffffff;
}

scrollbar {
    width:              5px;
    handle-width:       8px;
    handle-color:       #ff79c6;
    background-color:   #111111;
}

separator {
    background-color:   #0a0a0a;
}

textbox {
    background-color:   #0a0a0a;
    text-color:         #ffffff;
}
