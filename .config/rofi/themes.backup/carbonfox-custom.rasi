/* Carbonfox Rofi Theme — fully black + pink */
@theme "carbonfox-custom"

/* Main window */
window {
    background-color: #111111;
    border: 1;
    padding: 6;
}

/* Main area */
mainbox {
    border: 0;
    padding: 0;
}

/* Input bar (search box) */
inputbar {
    background: #111111;
    border: 1;               /* sets 1px border */
    border-color: #222222;   /* sets the color */
}

entry {
    background: #111111;
    foreground: #ff79c6;
    padding: 4px 8px;
}

/* All list items */
element {
    background-color: #111111;
    text-color: #ff79c6;
    padding: 4px 8px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

/* Selected items */
element.selected.normal,
element.selected.active,
element.selected.urgent {
    background-color: #ff79c6;
    text-color: #111111;
}

/* Active items */
element.normal.active {
    background-color: rgba(30,30,30,90%);
    text-color: #ff79c6;
}

/* Urgent items */
element.normal.urgent {
    background-color: #111111;
    text-color: #ff79c6;
}

/* Force all alternate items to use same colors */
element.normal.normal.alternate,
element.selected.normal.alternate,
element.normal.active.alternate,
element.selected.active.alternate,
element.normal.urgent.alternate,
element.selected.urgent.alternate {
    background-color: #111111;
    text-color: #ff79c6;
}

/* Text elements */
textbox {
    foreground: #ff79c6;
}

/* Scrollbar */
scrollbar {
    width: 5px;
    border: 0;
    handle-color: #ff79c6;
    handle-width: 8px;
    padding: 0;
}
