bindsym $mod+r mode "resize"

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

exec  --no-startup-id kitty
exec --no-startup-id brave
exec_always --no-startup-id picom -b
#exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id xrandr --output HDMI-1 --left-of DP-3 --rotate left

# Remove borders
default_border pixel 2
default_floating_border pixel 2

for_window [class=".*"] border pixel 2

# Add 1px gaps around windows
gaps inner 16
gaps outer 8


# Focused
client.focused          #ff69b4 #000000 #ff69b4 #ff69b4 #ff69b4

# Unfocused (dim gray)
client.unfocused        #333333 #000000 #777777 #333333 #333333

# Urgent
client.urgent           #ff69b4 #000000 #ffffff #ff69b4 #ff69b4

client.background       #000000

