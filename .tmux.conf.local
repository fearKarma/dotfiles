# =============================================================================
# ~/.tmux.conf.local  —  oh-my-tmux local overrides
# Oxycarbon theme + iarchean-style status bar
# =============================================================================

# -- display -------------------------------------------------------------------

tmux_conf_24b_colour=auto
tmux_conf_theme=enabled

# -- Oxycarbon colour palette --------------------------------------------------

tmux_conf_theme_colour_1="#1c1c1c"
tmux_conf_theme_colour_2="#232323"
tmux_conf_theme_colour_3="#555555"
tmux_conf_theme_colour_4="#60cfe8"
tmux_conf_theme_colour_5="#f1ff52"
tmux_conf_theme_colour_6="#1c1c1c"
tmux_conf_theme_colour_7="#d0d0d0"
tmux_conf_theme_colour_8="#1c1c1c"
tmux_conf_theme_colour_9="#f1ff52"
tmux_conf_theme_colour_10="#ee4f84"
tmux_conf_theme_colour_11="#53e2ae"
tmux_conf_theme_colour_12="#3a3a3a"
tmux_conf_theme_colour_13="#d0d0d0"
tmux_conf_theme_colour_14="#1c1c1c"
tmux_conf_theme_colour_15="#1c1c1c"
tmux_conf_theme_colour_16="#ee4f84"
tmux_conf_theme_colour_17="#d0d0d0"

# -- window style --------------------------------------------------------------

tmux_conf_theme_window_fg="default"
tmux_conf_theme_window_bg="default"
tmux_conf_theme_highlight_focused_pane=false
tmux_conf_theme_focused_pane_bg="$tmux_conf_theme_colour_2"

# -- pane borders --------------------------------------------------------------

tmux_conf_theme_pane_border_style=thin
tmux_conf_theme_pane_border="$tmux_conf_theme_colour_1"
tmux_conf_theme_pane_active_border="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

# -- message / command style ---------------------------------------------------

tmux_conf_theme_message_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_message_attr="bold"
tmux_conf_theme_message_command_fg="$tmux_conf_theme_colour_5"
tmux_conf_theme_message_command_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_command_attr="bold"
tmux_conf_theme_mode_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_mode_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_mode_attr="bold"

# -- status line global style --------------------------------------------------

tmux_conf_theme_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_status_bg="default"
tmux_conf_theme_status_attr="none"

# -- terminal title ------------------------------------------------------------

tmux_conf_theme_terminal_title="#h ○ #S | #I #W"

# -- window tab format ---------------------------------------------------------

tmux_conf_theme_window_status_fg="default"
tmux_conf_theme_window_status_bg="default"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format="#[fg=$tmux_conf_theme_colour_2,bg=$tmux_conf_theme_colour_7] #I #[fg=$tmux_conf_theme_colour_7,bg=$tmux_conf_theme_colour_1] #{?#{==:#{pane_current_command},ssh}, #{hostname_ssh},#{pane_current_command}}#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,󰨤,} "

tmux_conf_theme_window_status_current_fg="default"
tmux_conf_theme_window_status_current_bg="default"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format="#[fg=$tmux_conf_theme_colour_2,bg=$tmux_conf_theme_colour_4] #I #[fg=$tmux_conf_theme_colour_7,bg=$tmux_conf_theme_colour_12] #{?#{==:#{pane_current_command},ssh}, #{hostname_ssh},#{pane_current_command}}#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,,}#{?window_zoomed_flag,󰨤,} "

tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="bold"
tmux_conf_theme_window_status_bell_fg="default"
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="blink,bold"
tmux_conf_theme_window_status_last_fg="default"
tmux_conf_theme_window_status_last_bg="default"
tmux_conf_theme_window_status_last_attr="none"

# -- separators ----------------------------------------------------------------

tmux_conf_theme_left_separator_main=""
tmux_conf_theme_left_separator_sub="|"
tmux_conf_theme_right_separator_main=""
tmux_conf_theme_right_separator_sub="|"

# -- status left ---------------------------------------------------------------
# [pink: arch + date] | [cyan: clock + time] | [gray: volume]

tmux_conf_theme_status_left="  #(date '+%b %d %Y') |  #(date '+%H:%M') | #(/home/Pilgrim/.local/bin/tmux-vol)#{root} "

tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_2,$tmux_conf_theme_colour_2,$tmux_conf_theme_colour_7"
tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_4,$tmux_conf_theme_colour_3"
tmux_conf_theme_status_left_attr="bold,none,none"

# -- status right --------------------------------------------------------------
# in git repo:  online | memory | branch + status | prefix
# outside repo: online | memory | docker containers | prefix

tmux_conf_theme_status_right=" #{online} #{mouse}#{pairing}#{synchronized} |  #(/home/Pilgrim/.local/bin/tmux-mem) | #( '#{@starship_cmd}' git_branch )#( '#{@starship_cmd}' git_status )#(cd #{pane_current_path} && git rev-parse --is-inside-work-tree >/dev/null 2>&1 || docker ps -q 2>/dev/null | wc -l | xargs -I# printf ' #') | #{?client_prefix,󰒆,󰒅} "

tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12,$tmux_conf_theme_colour_2,$tmux_conf_theme_colour_2,$tmux_conf_theme_colour_2"
tmux_conf_theme_status_right_bg="default,$tmux_conf_theme_colour_11,$tmux_conf_theme_colour_4,$tmux_conf_theme_colour_16"
tmux_conf_theme_status_right_attr="none,none,none,bold"

# -- indicators ----------------------------------------------------------------

tmux_conf_theme_pairing="󰊠"
tmux_conf_theme_pairing_fg="none"
tmux_conf_theme_pairing_bg="none"
tmux_conf_theme_pairing_attr="none"

tmux_conf_theme_prefix="◉"
tmux_conf_theme_prefix_fg="none"
tmux_conf_theme_prefix_bg="none"
tmux_conf_theme_prefix_attr="none"

tmux_conf_theme_mouse=""
tmux_conf_theme_mouse_fg="none"
tmux_conf_theme_mouse_bg="none"
tmux_conf_theme_mouse_attr="none"

tmux_conf_theme_root=" 󱎜"
tmux_conf_theme_root_fg="none"
tmux_conf_theme_root_bg="none"
tmux_conf_theme_root_attr="bold,blink"

tmux_conf_theme_synchronized="󰘸"
tmux_conf_theme_synchronized_fg="none"
tmux_conf_theme_synchronized_bg="none"
tmux_conf_theme_synchronized_attr="none"

# -- battery -------------------------------------------------------------------

tmux_conf_battery_bar_length=0

# -- clock ---------------------------------------------------------------------

tmux_conf_theme_clock_colour="$tmux_conf_theme_colour_4"
tmux_conf_theme_clock_style="24"

# -- clipboard -----------------------------------------------------------------

tmux_conf_copy_to_os_clipboard=true

# -- user customizations -------------------------------------------------------

set -g default-shell /bin/zsh
set -g mouse on
set -g status-position top
set -g status-interval 5
set -g status-justify centre

# Start window and pane numbering at 1 instead of 0
set -g base-index 1
set -g pane-base-index 1
set -g renumber-windows on

set -g status 2
set -g status-format[1] " "
# popup / window bindings
bind g display-popup -w 90% -h 90% -E -d "#{pane_current_path}" "lazygit"
bind e new-window -c "#{pane_current_path}" "/bin/zsh -i -c 'sleep 0.2 && yazi'"
bind D display-popup -w 90% -h 90% -E "lazydocker"

# volume control via mousewheel on status bar (DBUS required for pipewire in tmux context)
bind -n WheelUpStatus run-shell "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
bind -n WheelDownStatus run-shell "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"

# passthrough for kitty graphics protocol (yazi image previews)
set -g allow-passthrough all
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
set -ga update-environment KITTY_LISTEN_ON

# -- TPM plugins ---------------------------------------------------------------

tmux_conf_update_plugins_on_launch=false
tmux_conf_update_plugins_on_reload=false
tmux_conf_uninstall_plugins_on_reload=false

set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'iarchean/tmux-starship'
set -g @plugin 'joshmedeski/tmux-nerd-font-window-name'

